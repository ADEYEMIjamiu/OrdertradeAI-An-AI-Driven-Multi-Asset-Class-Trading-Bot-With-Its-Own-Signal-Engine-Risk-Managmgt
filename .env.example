# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it's already excluded in .gitignore.

# Alpaca (US stocks, paper trading)
ALPACA_API_KEY=your_alpaca_paper_api_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key

# Binance Testnet (crypto)
BINANCE_TESTNET_API_KEY=your_binance_testnet_api_key
BINANCE_TESTNET_SECRET_KEY=your_binance_testnet_secret_key

# eToro (forex/commodities, Demo environment)
ETORO_API_KEY=your_etoro_api_key
ETORO_USER_KEY=your_etoro_user_key
ETORO_ENVIRONMENT=demo

# OANDA (forex/commodities, practice environment) -- added 2026-08-24,
# scaffolded in oanda_broker.py while researching alternative forex
# brokers. Not yet wired into app.py -- see that file's module docstring.
OANDA_API_TOKEN=your_oanda_personal_access_token
OANDA_ACCOUNT_ID=your_oanda_account_id
OANDA_ENVIRONMENT=practice

# MetaApi (mt_broker.py -- MT4/MT5 bridge covering Exness, XM,
# Pepperstone, AvaTrade, FXTM, IC Markets and most other retail
# forex/CFD brokers used outside the US/EU, added 2026-09-02). This is
# OrderTrade AI's OWN platform token from https://app.metaapi.cloud/token
# -- ONE token for the whole platform, used to provision every
# connected user's own MT account on MetaApi's side. It is NOT a
# per-user credential (each user's own MT login/password/server is
# stored separately, encrypted, via engines/tenant_engine.py -- see
# mt_broker.py's module docstring). Phase 1 only (standalone, not yet
# wired into any live engine) -- see that file for what does and
# doesn't work yet.
METAAPI_TOKEN=your_metaapi_platform_token

# Telegram (optional — trade-fill and performance-digest alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# SaaS platform (engines/tenant_engine.py) -- encrypts every user's own
# stored broker API keys/secrets at rest. Generate ONE key per
# environment (never reuse local/droplet) with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key permanently locks every stored credential -- there is
# no recovery. Never commit the real value.
SAAS_ENCRYPTION_KEY=your_generated_fernet_key

# Optional, comma-separated. Holds retired SAAS_ENCRYPTION_KEY values
# during a key rotation -- see _get_fernet()'s docstring in
# engines/tenant_engine.py for the full rotation steps. Leave unset
# under normal operation; only used while migrating stored credentials
# off an old key onto a new one.
SAAS_ENCRYPTION_KEY_PREVIOUS=

# Comma-separated email(s) that see the Admin Panel tab in saas_app.py
# (platform-wide kill switch, aggregate exposure, full user list). Empty
# by default -- fail-closed, not fail-open. Set to your own account's
# signup email once you've created it.
ADMIN_EMAILS=you@example.com

# Resend (engines/email_engine.py) -- sends password-reset and signup-
# verification emails for the SaaS product from noreply@ordertradeai.com.
# Uses a SEPARATE Resend account/team from any other project on
# purpose, so billing/usage never mixes between unrelated businesses.
# Generate a key in the Resend dashboard (API keys -> Create) after
# verifying ordertradeai.com as a domain there.
RESEND_API_KEY=your_resend_api_key

# Stripe (engines/billing_engine.py + saas_webhook_server.py) -- powers
# the SaaS product's subscription: a 7-day free trial, then $39/month
# flat rate. Uses a SEPARATE Stripe account from any other project on
# purpose (same reasoning as RESEND_API_KEY above) -- OrderTrade AI is
# plain SaaS billing, a different risk category from a money-
# transmission business line, and mixing them risks the SaaS billing
# getting swept into scrutiny that has nothing to do with it.
# STRIPE_SECRET_KEY / STRIPE_PUBLISHABLE_KEY: Developers -> API keys.
# STRIPE_PRICE_ID: the Price ID for the "OrderTrade AI Subscription"
# product (Product catalogue -> the product -> Pricing). This is the
# USD price and stays the fallback for every currency below that isn't
# configured yet.
# STRIPE_WEBHOOK_SECRET: shown once when the webhook endpoint is
# created (Developers -> Webhooks -> your endpoint -> Signing secret),
# used by saas_webhook_server.py to verify events actually came from
# Stripe before acting on them.
#
# STRIPE_PRICE_ID_<CCY> (added 2026-09-15, regional pricing): optional
# additional Prices on the SAME Product, one per non-USD currency this
# platform charges in -- see engines/geo_currency.py's module docstring
# for the full country->currency mapping and why it's these 5
# currencies specifically. Each must be created in the Stripe Dashboard
# as a fixed 39.00 in its own currency (Product -> Add another price ->
# pick the currency -> 39.00), NOT Stripe's Adaptive Pricing /
# currency_options feature, which does live FX conversion instead of a
# flat "39" -- see engines/billing_engine.py's create_checkout_session()
# for how the right one gets picked per visitor. Any of these left unset
# (or left as the placeholder below) simply falls back to charging that
# visitor in USD via STRIPE_PRICE_ID -- nothing breaks if you don't
# create all of them right away.
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_PRICE_ID=your_stripe_price_id
STRIPE_PRICE_ID_GBP=your_stripe_price_id_gbp
STRIPE_PRICE_ID_EUR=your_stripe_price_id_eur
STRIPE_PRICE_ID_AUD=your_stripe_price_id_aud
STRIPE_PRICE_ID_SGD=your_stripe_price_id_sgd
STRIPE_PRICE_ID_CAD=your_stripe_price_id_cad
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret
