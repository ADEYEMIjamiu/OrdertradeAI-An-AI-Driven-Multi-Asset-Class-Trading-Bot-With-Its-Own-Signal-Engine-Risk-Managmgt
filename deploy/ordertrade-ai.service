[Unit]
Description=OrderTrade AI trading dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AI-Trading-Bot
ExecStart=/root/AI-Trading-Bot/venv/bin/streamlit run app.py --server.port=8501 --server.address=127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
