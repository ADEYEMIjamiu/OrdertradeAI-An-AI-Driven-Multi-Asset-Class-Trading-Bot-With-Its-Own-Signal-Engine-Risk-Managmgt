[Unit]
Description=OrderTrade AI SaaS dashboard (multi-user, bring-your-own-broker)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/AI-Trading-Bot
# UPDATED 2026-08-27: dropped --server.baseUrlPath=saas -- this app now
# has its own dedicated domain (ordertradeai.com, see
# deploy/nginx-ordertradeai-com.conf) instead of living under
# ordertradeai.adeyemiadegbenro.com/saas/, so it serves at the plain
# root path again, same as it does when run locally.
ExecStart=/root/AI-Trading-Bot/venv/bin/streamlit run saas_app.py --server.port=8502 --server.address=127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
